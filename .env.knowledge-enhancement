# NOVA AI - Extended Environment Configuration
# Add these optional settings to your .env file to enable new features
# All existing settings remain unchanged and supported

# ============================================================================
# KNOWLEDGE ENHANCEMENT FEATURES (Optional)
# ============================================================================

# Enable/Disable knowledge enhancement system
# Default: true (enabled)
# Set to false to disable all knowledge provider features
KNOWLEDGE_ENHANCEMENT_ENABLED=true

# Source visibility level
# Options: hidden, minimal, normal, detailed, comprehensive
# Default: hidden (sources not shown to users)
DEFAULT_SOURCE_VISIBILITY=hidden

# Maximum parallel providers to query simultaneously
# Default: 3
# Higher = more comprehensive but slower
# Lower = faster but less comprehensive
MAX_PARALLEL_PROVIDERS=3

# Knowledge provider timeouts (in seconds)
# Default: 10 seconds per provider
WIKIPEDIA_API_TIMEOUT=10
GEEKSFORGEEKS_API_TIMEOUT=10
DOCUMENTATION_API_TIMEOUT=10

# Similarity threshold for deduplication (0.0 to 1.0)
# Default: 0.85
# Higher = more deduplication, lower = more redundancy allowed
KNOWLEDGE_DEDUP_THRESHOLD=0.85

# ============================================================================
# EXTENDED AI PROVIDERS (Optional)
# ============================================================================

# Mistral AI Provider
# Sign up at: https://console.mistral.ai
# Recommended model: mistral-large-latest
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Grok (xAI) Provider
# Sign up at: https://console.x.ai
# Recommended model: grok-2-1212
GROK_API_KEY=
GROK_MODEL=grok-2-1212

# Together AI Provider
# Sign up at: https://www.together.ai
# Supports: Meta Llama, Mistral, Orca, and more
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf

# OpenRouter Meta-Provider
# Sign up at: https://openrouter.ai
# Route to 200+ models with single API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-4o-mini
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=NOVA AI

# Ollama Local Provider (no API key needed)
# Install: https://ollama.ai
# Default location: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=neural-chat

# ============================================================================
# KNOWLEDGE PROVIDER SPECIFIC SETTINGS (Optional)
# ============================================================================

# Wikipedia Integration
# No API key needed - uses official public API
# Can be customized if needed
WIKIPEDIA_EXTRACT_LIMIT=3000

# GeeksforGeeks Integration
# No API key needed - uses search-based retrieval
# Respects site's terms of service
GEEKSFORGEEKS_SEARCH_LIMIT=10

# Official Documentation Integration
# No API key needed - links to public documentation
# Supports: Python, Java, React, FastAPI, Django, MDN, etc.
DOCUMENTATION_EXTRACT_LIMIT=2000

# ============================================================================
# LOGGING & DEBUGGING (Optional)
# ============================================================================

# Enable debug logging for knowledge enhancement
KNOWLEDGE_DEBUG_LOGGING=false

# Log level: DEBUG, INFO, WARNING, ERROR
KNOWLEDGE_LOG_LEVEL=INFO

# ============================================================================
# PERFORMANCE TUNING (Optional)
# ============================================================================

# Cache knowledge provider results (in seconds)
# Default: 3600 (1 hour)
# Set to 0 to disable caching
KNOWLEDGE_CACHE_TTL=3600

# Maximum knowledge facts to store per source
# Default: 20
KNOWLEDGE_MAX_FACTS=20

# Maximum sources per fusion operation
# Default: 5
KNOWLEDGE_MAX_FUSION_SOURCES=5

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================

# Enable Wikipedia provider
ENABLE_WIKIPEDIA_PROVIDER=true

# Enable GeeksforGeeks provider
ENABLE_GEEKSFORGEEKS_PROVIDER=true

# Enable Official Documentation provider
ENABLE_DOCUMENTATION_PROVIDER=true

# Enable knowledge fusion
ENABLE_KNOWLEDGE_FUSION=true

# Enable source visibility controls
ENABLE_SOURCE_VISIBILITY=true

# Enable automatic provider selection
ENABLE_AUTO_PROVIDER_SELECTION=true

# ============================================================================
# INTEGRATION EXAMPLES
# ============================================================================

# Example 1: Minimal Setup (just enable features)
# KNOWLEDGE_ENHANCEMENT_ENABLED=true

# Example 2: Production Setup (with extended providers)
# KNOWLEDGE_ENHANCEMENT_ENABLED=true
# MISTRAL_API_KEY=your-key
# GROK_API_KEY=your-key
# TOGETHER_API_KEY=your-key
# OPENROUTER_API_KEY=your-key

# Example 3: Local-Only Setup (Ollama only)
# KNOWLEDGE_ENHANCEMENT_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# DEFAULT_SOURCE_VISIBILITY=hidden

# Example 4: Research Setup (all sources visible)
# KNOWLEDGE_ENHANCEMENT_ENABLED=true
# DEFAULT_SOURCE_VISIBILITY=detailed
# KNOWLEDGE_MAX_FUSION_SOURCES=10
# MAX_PARALLEL_PROVIDERS=5

# ============================================================================
# NOTES
# ============================================================================

# 1. All settings are optional - existing functionality works unchanged
#
# 2. If a provider API key is missing, that provider is skipped gracefully
#
# 3. Set KNOWLEDGE_ENHANCEMENT_ENABLED=false to disable all new features
#
# 4. Knowledge providers have no cost (Wikipedia, GeeksforGeeks, Docs are free)
#
# 5. Extended AI providers (Mistral, Grok, Together) have their own pricing
#
# 6. Ollama runs locally with no API costs
#
# 7. All existing NOVA settings still work as before
#
# ============================================================================
